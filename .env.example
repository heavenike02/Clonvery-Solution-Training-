# Resend API key (https://resend.com/api-keys) — required for the enquiry form to send email
RESEND_API_KEY=

# Where enquiries are delivered (defaults to Clonervytrainingsolutions@outlook.com)
ENQUIRY_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend. Until then, leave blank to use
# Resend's test sender (onboarding@resend.dev), which can only deliver to your Resend account email.
ENQUIRY_FROM_EMAIL=

# Public site URL used for canonical links, sitemap and social images
NEXT_PUBLIC_SITE_URL=
